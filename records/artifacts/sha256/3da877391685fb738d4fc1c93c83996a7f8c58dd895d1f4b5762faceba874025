by
  classical
  let e : ℝ ≃ᵢ EuclideanSpace ℝ (Fin 1) :=
    IsometryEquiv.mk'
      (EuclideanSpace.single (0 : Fin 1))
      (fun x => x 0)
      (by
        intro x
        ext i
        fin_cases i
        simp)
      (by
        intro x y
        simp [EuclideanSpace.dist_single_same])
  let T : Set ℝ := e.symm '' S
  have hT : Bornology.IsBounded T := e.symm.isometry.lipschitz.isBounded_image hS
  have hdiamT : diam T = diam S := by
    simpa [T] using e.symm.diam_image S
  have hdiamT_pos : 0 < diam T := by
    simpa [hdiamT] using hd
  let a : ℝ := sInf T
  let b : ℝ := sSup T
  let m : ℝ := (a + b) / 2
  have hsub : T ⊆ Set.Icc a b := by
    simpa [a, b] using Bornology.IsBounded.subset_Icc_sInf_sSup hT
  have hcoverT : T ⊆ Set.Icc a m ∪ Set.Ioc m b := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := hsub hx
    rcases hx' with ⟨hxa, hxb⟩
    by_cases hxm : x ≤ m
    · exact Or.inl ⟨hxa, hxm⟩
    · exact Or.inr ⟨lt_of_not_ge hxm, hxb⟩
  have hab : diam T = b - a := by
    simpa [a, b] using Real.diam_eq hT
  have hlt_left : diam (Set.Icc a m) < diam T := by
    have hm : m = (a + b) / 2 := rfl
    have ham : a ≤ m := by
      unfold m
      linarith [hdiamT_pos, hab]
    calc
      diam (Set.Icc a m) = m - a := by rw [Real.diam_Icc ham]
      _ = (b - a) / 2 := by
        unfold m
        linarith
      _ < b - a := by linarith [hdiamT_pos]
      _ = diam T := by rw [hab]
  have hlt_right : diam (Set.Ioc m b) < diam T := by
    have hm : m = (a + b) / 2 := rfl
    have hmb : m ≤ b := by
      unfold m
      linarith [hdiamT_pos, hab]
    calc
      diam (Set.Ioc m b) = b - m := by rw [Real.diam_Ioc hmb]
      _ = (b - a) / 2 := by
        unfold m
        linarith
      _ < b - a := by linarith [hdiamT_pos]
      _ = diam T := by rw [hab]
  refine ⟨fun i => if i = 0 then e '' Set.Icc a m else e '' Set.Ioc m b, ?_, ?_⟩
  · intro x hx
    have hxT : e.symm x ∈ T := ⟨x, hx, by simp⟩
    have hxcover : e.symm x ∈ Set.Icc a m ∪ Set.Ioc m b := hcoverT hxT
    rcases hxcover with hxL | hxR
    · refine Set.mem_iUnion.2 ?_
      refine ⟨0, ?_⟩
      refine ⟨e.symm x, hxL, ?_⟩
      simp
    · refine Set.mem_iUnion.2 ?_
      refine ⟨1, ?_⟩
      refine ⟨e.symm x, hxR, ?_⟩
      simp
  · intro i
    fin_cases i
    · calc
        diam (e '' Set.Icc a m) = diam (Set.Icc a m) := by simpa using e.diam_image (Set.Icc a m)
        _ < diam T := hlt_left
        _ = diam S := hdiamT
    · calc
        diam (e '' Set.Ioc m b) = diam (Set.Ioc m b) := by simpa using e.diam_image (Set.Ioc m b)
        _ < diam T := hlt_right
        _ = diam S := hdiamT
